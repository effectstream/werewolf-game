{
  "name": "@werewolf-game/midnight-contract",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/_index.ts",
    "./witnesses": "./src/witnesses.ts",
    "./contract": "./src/managed/contract/index.js"
  },
  "scripts": {
    "compact": "compact compile +0.30.0 src/game.compact src/managed",
    "compact:fast": "compact compile +0.30.0 --skip-zk src/game.compact src/managed",
