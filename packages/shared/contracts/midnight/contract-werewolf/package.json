    "test": "bun run test/ww.test.ts",
    "test:simulation": "bun run test/ww.simulation.ts",
    "test:security": "bun run test/ww.security.test.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "eciesjs": "^0.4.16",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
