{
  "name": "@werewolf-game/node",
  "version": "0.3.22",
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "check": "bun build src/main.ts src/main.preprod.ts src/main.mainnet.ts --target=bun --outdir=/tmp/werewolf-node-check",
    "node:start": "bun run --inspect src/main.ts",
    "node:start:testnet": "bun run src/main.preprod.ts",
    "node:start:preprod": "bun run --env-file=../../../.env.preprod src/main.preprod.ts",
    "dev": "NODE_ENV=development bunx orchestrator start scripts/start.ts --log-dir logs",
    "testnet": "EFFECTSTREAM_ENV=testnet bunx orchestrator start scripts/start.preprod.ts",
    "preprod": "EFFECTSTREAM_ENV=testnet bun --env-file=../../../.env.preprod ./node_modules/.bin/orchestrator start scripts/start.preprod.ts",
    "node:start:mainnet": "bun run --env-file=../../../.env.mainnet src/main.mainnet.ts",
    "mainnet": "EFFECTSTREAM_ENV=mainnet bun --env-file=../../../.env.mainnet ./node_modules/.bin/orchestrator start scripts/start.mainnet.ts",
    "test": "bun run scripts/e2e.test.ts"
  },
  "dependencies": {
    "@werewolf-game/data-types": "workspace:*",
    "@werewolf-game/database": "workspace:*",
    "http-server": "^14.1.1",
    "@effectstream/concise": "0.100.26",
    "@effectstream/config": "0.100.26",
    "@effectstream/log": "0.100.26",
    "@effectstream/orchestrator": "0.100.26",
    "@effectstream/runtime": "0.100.26",
    "@effectstream/node-sdk": "0.100.26",
    "@effectstream/utils": "0.100.26",
    "@effectstream/sm": "0.100.26",
    "@effectstream/coroutine": "0.100.26",
    "@effectstream/db": "0.100.26",
    "@effectstream/midnight-contracts": "0.100.26",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnight-ntwrk/onchain-runtime-v3@3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/ledger-v7": "7.0.3",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-utils": "4.0.2",
    "@midnight-ntwrk/midnight-js-types": "4.0.2",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.2",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "fastify": "^5.4.0",
    "pg": "^8.14.0",
    "@sinclair/typebox": "0.34.41",
    "effection": "^3.5.0",
    "rxjs": "^7.8.2",
    "tweetnacl": "^1.0.3",
    "viem": "2.37.3",
    "prando": "^6.0.1",
    "rotating-file-stream": "^3.2.6",
    "tslog": "^4.9.3",
    "node-gyp": "^10.3.0"
  },
  "devDependencies": {}
}